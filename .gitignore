# Frontend build output — generated by `npm run build` (host) or baked fresh by
# the app image (multi-stage Dockerfile). Keep the dir so StaticFiles can mount
# it on a non-Docker run, but don't commit the bundle.
app/static/*
!app/static/.gitkeep
