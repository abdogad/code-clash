# Copy to .env and change for production. Dev defaults work out of the box.
PG_PASSWORD=codeclash
DATABASE_URL=postgresql://codeclash:codeclash@postgres:5432/codeclash
REDIS_URL=redis://redis:6379/0
# Production: set APP_ENV=production (the prod overlay does) — enables Secure cookies
# and refuses to boot with the dev secret, so set a real one:
#   JWT_SECRET=$(openssl rand -hex 32)
APP_ENV=dev
JWT_SECRET=dev-secret-change-me
